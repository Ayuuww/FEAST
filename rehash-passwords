<?php
include("conn/conn.php"); // DB connection
// tables and their roles
$tables = ['student', 'faculty', 'admin', 'superadmin'];

foreach ($tables as $table) {
    echo "<h3>Checking table: $table</h3>";

    $query = "SELECT idnumber, password FROM $table";
    $result = mysqli_query($conn, $query);

    while ($row = mysqli_fetch_assoc($result)) {
        $id = $row['idnumber'];
        $pwd = $row['password'];

        // check if already hashed (bcrypt hashes start with $2y$ or $2a$)
        if (preg_match('/^\$2y\$|^\$2a\$|^\$argon2id\$/', $pwd)) {
            echo "✅ $table: $id already hashed<br>";
            continue;
        }

        // hash the plain text password
        $hashed = password_hash($pwd, PASSWORD_DEFAULT);

        // update the DB
        $update = $conn->prepare("UPDATE $table SET password=? WHERE idnumber=?");
        $update->bind_param("ss", $hashed, $id);
        if ($update->execute()) {
            echo "🔒 $table: $id password rehashed<br>";
        } else {
            echo "❌ $table: $id failed to update<br>";
        }
    }
}

echo "<br>Done! You can now remove this file for security.";
